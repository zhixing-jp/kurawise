---
// 仕事＆ビザの記事本文（2026-10-23 段階1）。
// 従来の記事（section.body = 段落の配列）と、新しい記事（section.blocks = 型つきのブロック）の両方を表示する。
// ブロックの種類：
//   lead（冒頭の結論）／timeline（時系列）／bars（横棒グラフ）／table（表）／ol・ul（箇条書き）
//   p（段落）／note（小さな注記）／links（次の一歩のリンク）／calc（在留手数料の家族計算機）
//   quote（現場の声）／checklist（その場でチェックできる表。保存・送信しない）
// 文字列の中の <strong> <a> <code> はそのまま使う（記事データは運営者が書くもの）。
import VisaFeeCalc from './VisaFeeCalc.astro';
import OfferBlock from './OfferBlock.astro';  // 暮らし＆お金の知恵の部品（cardquiz・pointcalc・cardlist・disclosure。10/26）
interface Props { sections: any[]; lang: string; }
const { sections, lang } = Astro.props;
const fmt = (n: number) => n.toLocaleString(lang === 'vi' ? 'vi-VN' : 'en-US');
function maxOf(items: any[]) { return Math.max(...items.map((i) => i.value)); }
---
{sections.map((section: any) => (
  <section class="career-article-section">
    {section.heading && <h2 class="career-article-section-title">{section.heading}</h2>}
    {(section.body || []).map((para: string) => <p>{para}</p>)}
    {(section.blocks || []).map((b: any) => (
      b.t === 'lead' ? (
        <div class="cb-lead"><span class="cb-lead-label">{b.label}</span><p set:html={b.text} /></div>
      ) : b.t === 'timeline' ? (
        <ol class="cb-timeline">
          {b.items.map((i: any) => (
            <li class={i.hl ? 'hl' : ''}><span class="cb-timeline-date">{i.date}</span><span class="cb-timeline-text">{i.text}</span></li>
          ))}
        </ol>
      ) : b.t === 'bars' ? (
        <figure class="cb-bars">
          <figcaption>{b.title}<span class="cb-unit">（{b.unit}）</span></figcaption>
          {b.items.map((i: any) => (
            <div class={`cb-bar-row${i.hl ? ' hl' : ''}`}>
              <span class="cb-bar-label">{i.label}</span>
              <span class="cb-bar-track"><span class="cb-bar-fill" style={`width:${Math.max(4, Math.round(i.value / maxOf(b.items) * 100))}%`}></span></span>
              <span class="cb-bar-value">{i.display || fmt(i.value)}</span>
            </div>
          ))}
        </figure>
      ) : b.t === 'table' ? (
        <div class="cb-table-wrap">
          {b.caption && <p class="cb-table-caption">{b.caption}</p>}
          <table class={`cb-table${b.nowrapLast ? ' cb-table--nowrap-last' : ''}`}>
            <thead><tr>{b.head.map((h: string) => <th set:html={h} />)}</tr></thead>
            <tbody>{b.rows.map((r: string[]) => <tr>{r.map((c: string, ci: number) => ci === 0 ? <th scope="row" set:html={c} /> : <td set:html={c} />)}</tr>)}</tbody>
          </table>
        </div>
      ) : b.t === 'ol' ? (
        <ol class="cb-list cb-ol">{b.items.map((i: string) => <li set:html={i} />)}</ol>
      ) : b.t === 'ul' ? (
        <ul class="cb-list">{b.items.map((i: string) => <li set:html={i} />)}</ul>
      ) : b.t === 'note' ? (
        <p class="cb-note" set:html={b.text} />
      ) : b.t === 'links' ? (
        <div class="cb-links">{b.items.map((i: any) => <a href={i.href}>{i.text} ›</a>)}</div>
      ) : b.t === 'quote' ? (
        <blockquote class="cb-quote"><span class="cb-quote-label">{b.label}</span><p set:html={b.text} /></blockquote>
      ) : b.t === 'checklist' ? (
        <div class="cb-check" data-cb-check>
          <p class="cb-check-title">✅ {b.title}<span class="cb-check-count" data-count>0 / {b.items.length}</span></p>
          {b.items.map((i: string) => <label class="cb-check-item"><input type="checkbox" /><span set:html={i} /></label>)}
          <p class="cb-check-done" data-done hidden>{b.done}</p>
          <p class="cb-check-hint">{b.hint}</p>
        </div>
      ) : ['cardquiz', 'pointcalc', 'cardlist', 'disclosure', 'remitcalc', 'offerbtn'].includes(b.t) ? (
        <OfferBlock b={b} lang={lang} />
      ) : b.t === 'calc' ? (
        <VisaFeeCalc labels={b.labels} lang={lang} />
      ) : (
        <p set:html={b.text} />
      )
    ))}
  </section>
))}

<script is:inline>
  // チェック表：チェックの数を数え、全部そろったら一言出す（画面の中だけ。保存しない）
  document.querySelectorAll('[data-cb-check]').forEach(function (box) {
    var boxes = box.querySelectorAll('input[type=checkbox]');
    var count = box.querySelector('[data-count]');
    var done = box.querySelector('[data-done]');
    function upd() {
      var n = 0; boxes.forEach(function (c) { if (c.checked) n++; });
      count.textContent = n + ' / ' + boxes.length;
      done.hidden = n !== boxes.length;
      if (n === boxes.length && window.gtag && !box.__sent) { box.__sent = true; gtag('event', 'visa_checklist_complete'); }
    }
    boxes.forEach(function (c) { c.addEventListener('change', upd); });
  });
</script>
