    d1none: '今のところ、この記事のボタンは各社の公式サイトへの通常のリンクです（広告ではありません）。今後、広告（アフィリエイト）のリンクに変わる場合は、記事の先頭に「PR」と表示します。',
    d2: '紹介する順番と評価は、報酬の有無や金額で変えません。報酬のないサービスでも、良いものは載せます。',
    d3: '条件と特典は、各社の公式サイトで確かめています。変わることがあるので、申し込む前に公式サイトで確かめてください。',
    d4: '運営者：智行（在日約20年）。',
    about: '運営者情報'
  }
};
const t = L[lang] || L.ja;
const q2opts = [['net', t.net], ['conv', t.conv], ['paypay', t.paypay], ['aeon', t.aeon], ['none', t.none]];
const quizData = {
  names: Object.fromEntries(Object.values(P).map((p: any) => [p.id, nm(p.id)])),
  hrefs: Object.fromEntries(Object.values(P).map((p: any) => [p.id, href(p.id)])),
  why: { 'rakuten-card': t.whyRakuten, 'smbc-nl': t.whyConv, 'jcb-w': t.whyJcb, 'paypay-card': t.whyPaypay, 'aeon-select': t.whyAeon, net: t.whyNet }
};
---
{b.t === 'cardquiz' && (
  <div class="ob-quiz" data-ob-quiz data-quiz={JSON.stringify(quizData)}>
    <fieldset><legend>1. {t.q1}</legend>
      <label><input type="radio" name="q1" value="y" /> {t.yes}</label><label><input type="radio" name="q1" value="n" /> {t.no}</label></fieldset>
    <fieldset><legend>2. {t.q2}</legend>
      {q2opts.map(([v, l]) => <label><input type="radio" name="q2" value={v} /> {l}</label>)}</fieldset>
    <fieldset><legend>3. {t.q3}</legend>
      <label><input type="radio" name="q3" value="y" /> {t.often}</label><label><input type="radio" name="q3" value="n" /> {t.rarely}</label></fieldset>
    <div class="ob-quiz-result" data-result hidden>
      <p class="ob-quiz-label">{t.result}</p>
      <p class="ob-quiz-name" data-name></p>
      <p class="ob-quiz-why" data-why></p>
      <a class="ob-btn" data-btn href="#" target="_blank" rel="noopener" data-ga-offer="" data-ga-place="quiz">{t.btn} ›</a>
    </div>
    <p class="ob-small">{t.noteQuiz}</p>
  </div>
)}
{b.t === 'pointcalc' && (
  <div class="ob-calc" data-ob-calc data-yen={t.yen} data-lang={lang} data-rates={JSON.stringify(RATES.map((r) => ({ ...r, name: nm(r.id) })))}>
    <label class="ob-calc-label">{t.monthly}<input type="number" inputmode="numeric" min="0" step="1000" value="30000" data-monthly /></label>
    <div class="ob-calc-bars" data-bars></div>
    <p class="ob-small">{t.perYear}</p>
  </div>
)}
{b.t === 'cardlist' && (
  <div class="ob-cards">
    {b.items.map((c: any) => (
      <section class="ob-card" id={`card-${c.id}`}>
        <h3 class="ob-card-name">{nm(c.id)}<span class="ob-card-head">{c.head}</span></h3>
        <dl>
          <dt>{t.fit}</dt><dd>{c.fit}</dd>
          <dt>{t.merit}</dt><dd>{c.merit}</dd>
          <dt>{t.caution}</dt><dd>{c.caution}</dd>
        </dl>
        <p class="ob-before">{t.before}</p>
        <a class="ob-btn" href={href(c.id)} target="_blank" rel={rel(c.id)} data-ga-offer={c.id} data-ga-place="list">{t.btn} ›</a>
      </section>
    ))}
  </div>
)}
{b.t === 'remitcalc' && (
  <div class="ob-calc ob-remit" data-ob-remit data-lang={lang} data-yen={t.yen}>
    <label class="ob-calc-label">{t.amount}<input type="number" inputmode="numeric" min="0" step="1000" value={b.amount || 100000} data-r="amount" /></label>
    <fieldset class="ob-remit-dir"><legend>{t.dir}</legend>
      <label><input type="radio" name="rdir" value="a" checked={b.dir !== 'b'} /> {t.dirA}</label>
      <label><input type="radio" name="rdir" value="b" checked={b.dir === 'b'} /> {t.dirB}</label></fieldset>
    <label class="ob-calc-label">{t.mid}<input type="number" inputmode="decimal" min="0" step="any" value={b.mid} data-r="mid" /><span class="ob-small">{t.midHint}</span></label>
    <div class="ob-remit-svcs">
      {['A', 'B'].map((k, i) => (
        <div class="ob-remit-svc" data-svc>
          <p class="ob-remit-svc-name">{t.svc} {k}</p>
          <label class="ob-calc-label">{t.fee}<input type="number" inputmode="numeric" min="0" step="100" value={b.svcs[i].fee} data-r="fee" /></label>
          <label class="ob-calc-label">{t.rate}<input type="number" inputmode="decimal" min="0" step="any" value={b.svcs[i].rate} data-r="rate" /></label>
          <p class="ob-remit-out">{t.got}<strong data-out="got">-</strong></p>
          <p class="ob-remit-out">{t.cost}<strong data-out="cost">-</strong></p>
        </div>
      ))}
    </div>
    <p class="ob-small">{t.calcNote}</p>
  </div>
)}
{b.t === 'offerbtn' && (
  <div class="ob-card ob-offer">
    <h3 class="ob-card-name">{nm(b.id)}</h3>
    <p class="ob-offer-text" set:html={b.text} />
    <p class="ob-before">{t.beforeSvc}</p>
    <a class="ob-btn" href={href(b.id)} target="_blank" rel={rel(b.id)} data-ga-offer={b.id} data-ga-place={b.place || 'article'}>{t.btnSvc} ›</a>
  </div>
)}
{b.t === 'disclosure' && (
  <div class="ob-disclosure">
    <ul>
      <li>{(b.ids ? b.ids.some((i: string) => P[i]?.affiliate_url) : hasAffiliate) ? t.d1 : t.d1none}</li>
      <li>{t.d2}</li>
      <li>{t.d3}</li>
      <li>{t.d4}<a href="/about/">{t.about} ›</a></li>
    </ul>
  </div>
)}
