---
import { getLangFromUrl } from '../i18n/index.js';
import { SECTIONS } from '../data/sections';
import { SECTION_NAMES, TAB_BREAK_AFTER, type SectionKey } from '../data/sectionNames';
import careerReferral from '../../public/data/career/referral.json';
import guideProducts from '../../public/data/guides/products.json';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  rescueCss?: boolean;
  medicalCss?: boolean;
  careerCss?: boolean;
  careerGroup?: string;
  guidesCss?: boolean;
  noindex?: boolean;
  skipReadTracking?: boolean;
  // 以下用于站点语言体系之外的页面（如 /kuraphoto/ 的7种语言公开页）
  uiLang?: string;        // 页头・tab・页脚使用的站点语言（不传则按URL判断）
  htmlLang?: string;      // <html lang> 的值（不传则同 uiLang）
  alternates?: { hreflang: string; href: string }[];  // 传入时替换自动生成的 hreflang
  langOptions?: { label: string; href: string; active: boolean }[];  // 传入时替换页头的语言菜单（直接跳转链接）
  appsCss?: boolean;      // 应用公开页样式 /css/apps.css
  breadcrumbs?: { name: string; url?: string }[];  // 構造化データ（BreadcrumbList）用。渡さなければセクションから自動で作る
}

const {
  title = 'Kurawise',
  description = '在日本看病、租房、办手续怎么用日语说？23个真实场景对话，真人核实，跟读练习，完全免费。',
  ogImage = 'https://kurawise.com/assets/og-image.webp',
  rescueCss = false,
  medicalCss = false,
  careerCss = false,
  careerGroup,
  guidesCss = false,
  noindex = false,
  skipReadTracking = false,
  uiLang,
  htmlLang,
  alternates,
  langOptions,
  appsCss = false,
  breadcrumbs
} = Astro.props;

// 単一URLのページのうち、最初の表示が日本語のもの（/apps/・/kurashi/）は、サーバー側の言語も日本語にする
// （表示後は base.js がその人の言語に描き直す）
const lang = uiLang || (/^\/(apps|kurashi|about|ad-policy|privacy)\/?$/.test(Astro.url.pathname) ? 'ja' : getLangFromUrl(Astro.url));
const activeLangOption = langOptions ? langOptions.find((o) => o.active) : undefined;

const siteUrl = 'https://kurawise.com';

// 内容阅读完成度埋点用：标记当前页面属于哪个内容板块，非内容页（首页/about/guides等）为null不触发
const contentSection = skipReadTracking ? null : (rescueCss ? 'rescue' : (medicalCss ? 'medical' : (careerCss ? 'career' : null)));

// 医疗协调服务浮动banner：贴在就医指南版块全程显示（medicalCss=true 的页面），
// 落地页/咨询页自己不再显示banner（用户已经在导流终点，不需要再引导一次）。
const isReferralOwnPage = Astro.url.pathname.includes('/medical/service/');
const showMedicalReferralBanner = medicalCss && !isReferralOwnPage;
const medicalServiceUrl = lang === 'zh' ? '/medical/service/' : `/${lang}/medical/service/`;
// 医療の同行・通訳サービスへの案内。「緊急」とは書かない（命に関わるときは119番が先。10/23）
const referralBannerText: Record<string, string> = {
  zh: '担心语言沟通？可以请人翻译、陪同',
  'zh-TW': '擔心語言溝通？可以請人口譯、陪同',
  en: 'Worried about the language barrier? Request an interpreter or companion',
  vi: 'Lo lắng về ngôn ngữ? Bạn có thể nhờ phiên dịch hoặc người đi cùng',
  ko: '언어가 걱정되나요? 통역・동행을 요청할 수 있습니다',
  ja: '言葉の不安が大きいときは、通訳・同行を頼めます'
};
const referralBannerCta: Record<string, string> = {
  zh: '了解详情', 'zh-TW': '了解詳情', en: 'Learn more', vi: 'Tìm hiểu', ko: '자세히 보기', ja: '詳しく見る'
};

// 就职版块悬浮banner：与医疗banner同一套机制，各自独立的dismiss key和GA事件，
// 两者互斥（页面要么是medicalCss要么是careerCss），不会同时出现。
// Phase 1仅简体中文，落地页/登记页自身不显示。
const isCareerReferralOwnPage = Astro.url.pathname.includes('/career/interest/');
const showCareerReferralBanner = careerCss && !isCareerReferralOwnPage;
// banner文案按文章所属阶段分组（prep/interview/decide/onboard），未传group（如hub页）时用default兜底。
// referral.json里banner是中文版，其它语言存在banner_{lang}键（banner_en/banner_ja等），
// 用当前lang动态取值时需要先转成Record<string, unknown>宽类型，避免精确字面量类型报ts(7053)。
const careerReferralUntyped = careerReferral as unknown as Record<string, unknown>;
const careerBannerMap: Record<string, { text: string; cta: string }> =
  (careerReferralUntyped[`banner_${lang}`] as Record<string, { text: string; cta: string }>) || careerReferral.banner;
const careerBannerData = (careerGroup && careerBannerMap[careerGroup]) || careerBannerMap.default;
const careerInterestBasePath = lang === 'zh' ? '/career/interest/' : `/${lang}/career/interest/`;
const careerInterestUrl = careerGroup ? `${careerInterestBasePath}?from=${careerGroup}` : careerInterestBasePath;
// 面试类文章：面试指南PDF已作为商品上架（目前仅简体中文），横幅直接导向专业指南商品页；
// 其他类别和其他语言仍导向"抢先登记"页。横幅文案另行调整。
// ただし、面接ガイドの決済リンクがまだ仮のうちは、購入できないので「抢先登记」ページに案内する（10/23）
const interviewGuideReady = guideProducts.products.some((p: any) => p.id === 's11-interview-pdf' && !p.hidden && typeof p.stripePaymentLink === 'string' && p.stripePaymentLink.startsWith('https://'));
const careerBannerUrl = (careerGroup === 'interview' && lang === 'zh' && interviewGuideReady) ? SECTIONS.guides.url : careerInterestUrl;
const careerReferralBannerText = careerBannerData.text;
const careerReferralBannerCta = careerBannerData.cta;

const langLabels: Record<string, string> = {
  'zh': '简体中文', 'zh-TW': '繁體中文',
  'en': 'English', 'vi': 'Tiếng Việt', 'ko': '한국어', 'ja': '日本語'
};

const langPaths: Record<string, string> = {
  'zh': '/', 'zh-TW': '/zh-TW/',
  'en': '/en/', 'vi': '/vi/', 'ko': '/ko/', 'ja': '/ja/'
};

// 静态导航标签多语言
// 说明：learn版块已并入rescue并下线，第2个tab暂时指向/medical/占位页
// （就医流程・日语版块，内容制作中），medical文案沿用zh.json已有的tab_medical key
// 底部tab的文字＝各セクションの正式名（src/data/sectionNames.ts，10/23決定）。
// 入りきらないときだけ、TAB_BREAK_AFTER で指定した位置で2行に折り返す（<wbr> + word-break:keep-all）。
const escHtml = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const tabLabelHtml = (key: SectionKey): string => {
  const names = SECTION_NAMES[key] as Record<string, string>;
  const name = names[lang] || names.en;
  const brk = (TAB_BREAK_AFTER[key] as Record<string, string> | undefined)?.[lang];
  if (brk && name.startsWith(brk)) return escHtml(brk) + '<wbr>' + escHtml(name.slice(brk.length));
  return escHtml(name);
};

const rescueUrl  = lang === 'zh' ? '/' : `/${lang}/`;
// medical已有 [lang]/medical/* 多语言目录，此前一直误留着旧的单一路径写法
// （占位页时代遗留），实际已可以按语言跳转，这里一并修正
const medicalUrl = lang === 'zh' ? '/medical/' : `/${lang}/medical/`;
// career已完成 [lang]/career/* 多语言目录，按语言跳转
const careerUrl = lang === 'zh' ? '/career/' : `/${lang}/career/`;
// ST与应用版块：单一路径入口（版块内再按语言分）
const kurashiUrl = SECTIONS.kurashi.url;
const appsUrl = SECTIONS.apps.url;
// about同medical，单一路径，内部按当前语言显示对应文案
const aboutUrl = '/about/';

const footerLabels: Record<string, string> = {
  zh: '关于我们', 'zh-TW': '關於我們',
  en: 'About Us', vi: 'Về Chúng Tôi', ko: '소개', ja: '私たちについて'
};
// 0-B（10/23）：フッターに「広告について」を追加（タブ4・5のページだけ。showAdPolicyLink）。プライバシーポリシーは全ページ。特商法の表記は有料の依頼を受ける前に追加する
const footerPrivacyLabels: Record<string, string> = {
  zh: '隐私政策', 'zh-TW': '隱私權政策', en: 'Privacy Policy', vi: 'Quyền riêng tư', ko: '개인정보 처리방침', ja: 'プライバシーポリシー'
};
const footerAdLabels: Record<string, string> = {
  zh: '关于广告', 'zh-TW': '關於廣告', en: 'Advertising Policy', vi: 'Về quảng cáo', ko: '광고 안내', ja: '広告について'
};
const footerCopyright: Record<string, string> = {
  zh: `© ${new Date().getFullYear()} Kurawise`,
  'zh-TW': `© ${new Date().getFullYear()} Kurawise`,
  en: `© ${new Date().getFullYear()} Kurawise`,
  vi: `© ${new Date().getFullYear()} Kurawise`,
  ko: `© ${new Date().getFullYear()} Kurawise`,
  ja: `© ${new Date().getFullYear()} Kurawise`
};

const currentPath = Astro.url.pathname;
const isMedical = currentPath.includes('/medical');
const isCareer = currentPath.includes('/career');
const isGuides = currentPath.includes('/guides') || currentPath.includes('/download');
const isKurashi = currentPath.startsWith('/kurashi');
const isApps = currentPath.startsWith('/apps') || currentPath.startsWith('/kuraphoto');
// どのタブにも属さないページ（about・広告について）では、タブを選ばれた表示にしない（10/23）
const isNoTab = /^\/(about|ad-policy|privacy)\/?$/.test(currentPath);
// 「広告について」のリンクは、広告を載せるタブ4・5のページ（とそのページ自身）だけに出す（10/23 智行）
const showAdPolicyLink = isKurashi || isApps || /^\/ad-policy\/?$/.test(currentPath);
const searchPlaceholders: Record<string, string> = { zh: '搜索...', 'zh-TW': '搜尋...', en: 'Search...', vi: 'Tìm kiếm...', ko: '검색...', ja: '検索...' };
// 単一URLのページ（言語ごとのURLがなく、文章をブラウザ側で言語に合わせて表示するページ）。
// これ以外のページは「そのページの言語」が決まっているので <html data-page-lang> に書き、
// base.js はそれを最優先で使う（＝中文ページで英語の設定が残っていても中文として扱う）。
const isSinglePath = !uiLang && /^\/(about|kurashi|apps|ad-policy|privacy)\/?$/.test(currentPath);
// 全6言語の版がそろっているページ（トップ・日常会話・病院＆医療・仕事＆ビザ）。
// ブラウザの言語とページの言語が違うとき、その言語の版への案内を出す（自動では移動しない。K12）
const strippedForSuggest = currentPath.replace(/^\/(en|zh-TW|vi|ko|ja)(?=\/|$)/, '') || '/';
const langSuggestEligible = !uiLang && (strippedForSuggest === '/' || /^\/(rescue|medical|career)\//.test(strippedForSuggest));

// ── 0-S（2026-10-23）検索向けの調整 ──
// ① 病院・仕事のページで、タイトルに「日本」の文脈が入っていないものは、言語ごとの文脈を足す
//    （例：「挂号话术与流程」→「挂号话术与流程｜在日本看病｜Kurawise」）
const isCJK = ['zh', 'zh-TW', 'ja'].includes(lang);
const SEP = isCJK ? '｜' : ' | ';
const SEO_CONTEXT: Record<string, Record<string, string>> = {
  medical: { zh: '在日本看病', 'zh-TW': '在日本看病', en: 'Seeing a Doctor in Japan', vi: 'Khám bệnh ở Nhật', ko: '일본 병원 이용', ja: '日本の病院のかかり方' },
  career:  { zh: '在日本工作', 'zh-TW': '在日本工作', en: 'Working in Japan', vi: 'Làm việc tại Nhật', ko: '일본에서 일하기', ja: '日本で働く' }
};
const baseTitle = title.replace(/\s*[|｜]\s*Kurawise\s*$/, '');
const ctxKey = medicalCss ? 'medical' : (careerCss ? 'career' : null);
const needsContext = ctxKey && !/日本|Japan|Nhật|일본/.test(baseTitle);
const pageTitle = needsContext
  ? `${baseTitle}${SEP}${SEO_CONTEXT[ctxKey!][lang] || SEO_CONTEXT[ctxKey!].en}${SEP}Kurawise`
  : (/Kurawise\s*$/.test(title) ? title : `${title}${SEP}Kurawise`);

// ② 道案内の構造化データ（BreadcrumbList）。ホーム ＞ セクション ＞ このページ
const pathNoLang = currentPath.replace(/^\/(en|zh-TW|vi|ko|ja)(?=\/|$)/, '') || '/';
const sectionKey: SectionKey | null =
  pathNoLang.startsWith('/medical') ? 'medical' :
  pathNoLang.startsWith('/career') ? 'career' :
  pathNoLang.startsWith('/rescue') ? 'rescue' :
  pathNoLang.startsWith('/kurashi') ? 'kurashi' :
  (pathNoLang.startsWith('/apps') || pathNoLang.startsWith('/kuraphoto')) ? 'apps' : null;
const langPrefix = lang === 'zh' ? '' : `/${lang}`;
const sectionUrls: Record<SectionKey, string> = {
  rescue: `${langPrefix}/`, medical: `${langPrefix}/medical/`, career: `${langPrefix}/career/`, kurashi: '/kurashi/', apps: '/apps/'
};
const homeUrlForLd = `${siteUrl}${langPrefix}/`;
let crumbList: { name: string; url?: string }[] = [];
if (breadcrumbs && breadcrumbs.length) {
  crumbList = breadcrumbs;
} else if (pathNoLang !== '/') {
  if (sectionKey && sectionKey !== 'rescue') {
    const secUrl = sectionUrls[sectionKey];
    const isHub = currentPath === secUrl || currentPath === secUrl.replace(/\/$/, '');
    crumbList.push({ name: (SECTION_NAMES[sectionKey] as Record<string, string>)[lang] || SECTION_NAMES[sectionKey].en, url: isHub ? undefined : `${siteUrl}${secUrl}` });
    if (!isHub) crumbList.push({ name: baseTitle });
  } else {
    crumbList.push({ name: baseTitle });
  }
}
const breadcrumbLd = crumbList.length ? {
  "@type": "BreadcrumbList",
  "itemListElement": [{ name: 'Kurawise', url: homeUrlForLd }, ...crumbList].map((c, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": c.name,
    ...(c.url ? { "item": c.url } : {})
  }))
} : null;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "name": "Kurawise",
      "url": siteUrl
    },
    ...(breadcrumbLd ? [breadcrumbLd] : [])
  ]
};
---

<!DOCTYPE html>
<html lang={htmlLang || lang} data-lang-fixed={htmlLang ? '' : undefined} data-page-lang={isSinglePath ? undefined : lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#FF3B30">
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'}>
  <meta name="author" content="Kurawise">

  <title>{pageTitle}</title>
  <meta name="description" content={description}>

  <!-- Open Graph -->
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={Astro.url}>
  <meta property="og:type" content="website">
  <meta property="og:image" content={ogImage}>
  <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : lang === 'zh-TW' ? 'zh_TW' : lang}>
  <meta property="og:site_name" content="Kurawise">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content={pageTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <!-- Canonical & hreflang -->
  <link rel="canonical" href={Astro.url}>
  {alternates && alternates.map((a) => (
    <link rel="alternate" hreflang={a.hreflang} href={a.href} />
  ))}
  {!alternates && langSuggestEligible && Object.entries(langPaths).map(([l]) => {
  // 从当前URL路径中去掉语言前缀，得到纯路径
  const currentPath = Astro.url.pathname;
  const strippedPath = currentPath
    .replace(/^\/(en|zh-TW|vi|ko|ja)\//, '/')
    .replace(/^\/(en|zh-TW|vi|ko|ja)$/, '/');
  // 构建该语言版本的完整URL
  const langUrl = l === 'zh'
    ? `${siteUrl}${strippedPath}`
    : `${siteUrl}/${l}${strippedPath === '/' ? '/' : strippedPath}`;
  return (
    <link rel="alternate" hreflang={l === 'zh' ? 'zh-CN' : l} href={langUrl} />
  );
  })}
  {!alternates && langSuggestEligible && <link rel="alternate" hreflang="x-default" href={`${siteUrl}${Astro.url.pathname.replace(/^\/(en|zh-TW|vi|ko|ja)\//, '/').replace(/^\/(en|zh-TW|vi|ko|ja)$/, '/')}`} />}

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">

  <!-- CSS -->
  <link rel="stylesheet" href="/css/base.css">
  { rescueCss && <link rel="stylesheet" href="/css/rescue.css" /> }
  { medicalCss && <link rel="stylesheet" href="/css/medical.css" /> }
  { careerCss && <link rel="stylesheet" href="/css/career.css" /> }
  { guidesCss && <link rel="stylesheet" href="/css/guides.css" /> }
  { appsCss && <link rel="stylesheet" href="/css/apps.css" /> }

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-N484C7TXZ0" is:inline></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-N484C7TXZ0');
  </script>

  <!-- 内容阅读完成度埋点：只在rescue/medical/career内容页生效，滚动到页面底部附近时记一次，
       每个页面只记一次，用于判断"读完的人多不多"这类现有pageview无法回答的问题 -->
  <script is:inline define:vars={{ contentSection }}>
    (function () {
      if (!contentSection) return;
      var fired = false;
      function checkScroll() {
        if (fired) return;
        var scrollBottom = window.scrollY + window.innerHeight;
        var docHeight = document.documentElement.scrollHeight;
        if (scrollBottom >= docHeight - 100) {
          fired = true;
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'content_read_complete', {
              section: contentSection,
              page_path: window.location.pathname
            });
          }
          window.removeEventListener('scroll', checkScroll);
        }
      }
      window.addEventListener('scroll', checkScroll, { passive: true });
      // 有些页面内容很短，不需要滚动就已经在底部，加载后立即检查一次
      if (document.readyState === 'complete') {
        checkScroll();
      } else {
        window.addEventListener('load', checkScroll);
      }
    })();
  </script>

  <link href="/pagefind/pagefind-ui.css" rel="stylesheet">
</head>
<body>

  <!-- Header -->
  <div id="header">
    <div class="header-bar">
      <div class="wordmark">
        <div class="wordmark">
          <a href={rescueUrl} style="text-decoration:none;color:inherit;">
            <span id="siteTitle">Kurawise</span>
          </a>
        <div class="wordmark-dot"></div>
      </div>
    </div>

      <!-- 探索栏 -->
      <div class="search-wrap" id="searchWrap">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
        <input id="searchInput" type="search" autocomplete="off" placeholder={searchPlaceholders[lang] || searchPlaceholders.zh}>
      </div>

      <!-- 语言切换 -->
      <div id="langSwitchWrap" class="lang-switch-wrap">
        <button id="langBtn" class="lang-btn" aria-label="Switch language">🌐 {activeLangOption ? activeLangOption.label : langLabels[lang]}</button>
        <div id="langMenu" class="lang-menu" style="display:none">
          {langOptions
            ? langOptions.map((o) => (
                <a href={o.href} class={`lang-menu-item${o.active ? ' active' : ''}`}>{o.label}</a>
              ))
            : Object.entries(langLabels).map(([l, label]) => (
                <a href="javascript:void(0)" onclick={`switchLang('${l}')`} class={`lang-menu-item${l === lang ? ' active' : ''}`}>{label}</a>
              ))}
        </div>
      </div>
    </div>
  </div>

  <!-- 言語の案内：ブラウザの言語とページの言語が違うときだけ表示（base.js が表示を判断） -->
  {langSuggestEligible && (
    <div id="langSuggest" class="lang-suggest" hidden>
      <span class="lang-suggest-text"></span>
      <a class="lang-suggest-link" href="#"></a>
      <button type="button" class="lang-suggest-close" aria-label="Close">✕</button>
    </div>
  )}

  <!-- Page Content -->
  <slot />

  <!-- Footer -->
  <footer id="siteFooter" style="max-width:640px;margin:0 auto;padding:24px 20px 100px;text-align:center;border-top:1px solid rgba(0,0,0,.06);margin-top:40px;">
    <a id="footerAboutLink" href={aboutUrl} style="font-size:13px;color:var(--muted,#888);text-decoration:none;">{footerLabels[lang] || footerLabels.zh}</a>
    <span style="font-size:13px;color:var(--muted,#888);margin:0 8px;" aria-hidden="true">｜</span>
    <a id="footerPrivacyLink" href="/privacy/" style="font-size:13px;color:var(--muted,#888);text-decoration:none;">{footerPrivacyLabels[lang] || footerPrivacyLabels.zh}</a>
    {showAdPolicyLink && <>
      <span style="font-size:13px;color:var(--muted,#888);margin:0 8px;" aria-hidden="true">｜</span>
      <a id="footerAdLink" href="/ad-policy/" style="font-size:13px;color:var(--muted,#888);text-decoration:none;">{footerAdLabels[lang] || footerAdLabels.zh}</a>
    </>}
    <div id="footerCopyright" style="font-size:11px;color:rgba(0,0,0,.3);margin-top:8px;">{footerCopyright[lang] || footerCopyright.zh}</div>
  </footer>

  <!-- 搜索结果面板 -->
  <div id="searchPanel" style="display:none;position:fixed;top:0;left:50%;transform:translateX(-50%);width:100%;max-width:430px;height:100%;background:var(--bg);z-index:500;overflow-y:auto;padding:60px 14px 80px;">
    <div id="searchResults"></div>
  </div>

  {showMedicalReferralBanner && (
    <div class="med-referral-banner" id="medReferralBanner">
      <button type="button" class="med-referral-banner-close" id="medReferralBannerClose" aria-label="关闭">✕</button>
      <span class="med-referral-banner-text">{referralBannerText[lang] || referralBannerText.zh}</span>
      <a
        href={medicalServiceUrl}
        class="med-referral-banner-cta"
        data-ga-event="referral_banner_click"
      >
        {referralBannerCta[lang] || referralBannerCta.zh} →
      </a>
    </div>
  )}

  {showCareerReferralBanner && (
    <div class="career-referral-banner" id="careerReferralBanner">
      <button type="button" class="career-referral-banner-close" id="careerReferralBannerClose" aria-label="关闭">✕</button>
      <span class="career-referral-banner-text">{careerReferralBannerText}</span>
      <a
        href={careerBannerUrl}
        class="career-referral-banner-cta"
        data-ga-event="career_banner_click"
      >
        {careerReferralBannerCta} →
      </a>
    </div>
  )}

  <script is:inline>
    (function () {
      function initReferralBanner() {
        const banner = document.getElementById('medReferralBanner');
        if (!banner) return;

        // 同一次访问内关闭过就不再显示（用 sessionStorage，刷新页面/换标签仍会再出现，不做"永久隐藏"）
        try {
          if (sessionStorage.getItem('lj_med_referral_dismissed') === '1') {
            banner.style.display = 'none';
            return;
          }
        } catch (e) {}

        const closeBtn = document.getElementById('medReferralBannerClose');
        if (closeBtn) {
          closeBtn.addEventListener('click', function () {
            banner.style.display = 'none';
            try { sessionStorage.setItem('lj_med_referral_dismissed', '1'); } catch (e) {}
          });
        }

        const cta = banner.querySelector('[data-ga-event="referral_banner_click"]');
        if (cta) {
          cta.addEventListener('click', function () {
            if (typeof window.gtag === 'function') {
              window.gtag('event', 'referral_banner_click', { page_path: window.location.pathname });
            }
          });
        }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initReferralBanner);
      } else {
        initReferralBanner();
      }
    })();
  </script>

  <script is:inline>
    (function () {
      function initCareerReferralBanner() {
        const banner = document.getElementById('careerReferralBanner');
        if (!banner) return;

        // 独立的sessionStorage key，关掉医疗banner不会影响这个，反之亦然
        try {
          if (sessionStorage.getItem('lj_career_referral_dismissed') === '1') {
            banner.style.display = 'none';
            return;
          }
        } catch (e) {}

        const closeBtn = document.getElementById('careerReferralBannerClose');
        if (closeBtn) {
          closeBtn.addEventListener('click', function () {
            banner.style.display = 'none';
            try { sessionStorage.setItem('lj_career_referral_dismissed', '1'); } catch (e) {}
          });
        }

        const cta = banner.querySelector('[data-ga-event="career_banner_click"]');
        if (cta) {
          cta.addEventListener('click', function () {
            if (typeof window.gtag === 'function') {
              window.gtag('event', 'career_banner_click', { page_path: window.location.pathname });
            }
          });
        }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initCareerReferralBanner);
      } else {
        initCareerReferralBanner();
      }
    })();
  </script>

  <script src="/pagefind/pagefind-ui.js" is:inline></script>
  <script is:inline>
    let search;
    async function initSearch() {
      if (search) return;
      const PagefindUI = window.PagefindUI;
      search = new PagefindUI({
        element: '#searchResults',
        showImages: false,
        resetStyles: true,
        translations: {
          placeholder: currentLang === 'en' ? 'Search...' :
                      currentLang === 'ko' ? '검색...' :
                      currentLang === 'vi' ? 'Tìm kiếm...' :
                      currentLang === 'ja' ? '検索...' :
                      currentLang === 'zh-TW' ? '搜尋...' : '搜索...'
        }
      });
    }

    const searchInput = document.getElementById('searchInput');
    const searchPanel = document.getElementById('searchPanel');

    searchInput.addEventListener('focus', async () => {
      await initSearch();
      searchPanel.style.display = 'block';
    });

    searchInput.addEventListener('input', async (e) => {
      await initSearch();
      if (e.target.value) {
        searchPanel.style.display = 'block';
        search.triggerSearch(e.target.value);
      } else {
        searchPanel.style.display = 'none';
      }
    });

    document.addEventListener('click', (e) => {
      if (!searchPanel.contains(e.target) && e.target !== searchInput) {
        searchPanel.style.display = 'none';
        searchInput.value = '';
      }
    });
  </script>

  <!-- Back to Top -->
  <button id="backTop" onclick="window.scrollTo({top:0,behavior:'smooth'})" aria-label="Back to top">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <path d="M18 15l-6-6-6 6"/>
    </svg>
  </button>

  <!-- Toast -->
  <div id="toast"></div>

  <!-- Bottom Navigation -->
  <nav id="tabBar">
    <a href={rescueUrl} data-tab="rescue" class={`tab${(!isMedical && !isCareer && !isGuides && !isKurashi && !isApps && !isNoTab) ? ' on' : ''}`}>
      <div class="tab-icon">🛡️</div>
      <span class="tab-label" set:html={tabLabelHtml('rescue')} />
    </a>
    <a href={medicalUrl} data-tab="medical" class={`tab${isMedical ? ' on' : ''}`}>
      <div class="tab-icon">🏥</div>
      <span class="tab-label" set:html={tabLabelHtml('medical')} />
    </a>
    <a href={careerUrl} data-tab="career" class={`tab${isCareer ? ' on' : ''}`}>
      <div class="tab-icon">💼</div>
      <span class="tab-label" set:html={tabLabelHtml('career')} />
    </a>
    <a href={kurashiUrl} data-tab="kurashi" class={`tab${isKurashi ? ' on' : ''}`}>
      <div class="tab-icon">💰</div>
      <span class="tab-label" set:html={tabLabelHtml('kurashi')} />
    </a>
    <a href={appsUrl} data-tab="apps" class={`tab${isApps ? ' on' : ''}`}>
      <div class="tab-icon">📱</div>
      <span class="tab-label" set:html={tabLabelHtml('apps')} />
    </a>
  </nav>
  <script is:inline define:vars={{ SECTION_NAMES_JSON: SECTION_NAMES, TAB_BREAK_JSON: TAB_BREAK_AFTER }}>
    // タブの文字が2行になる言語では、タブバーが高くなる。その高さを --tab-h に入れて、
    // ページ下の余白・タブバーの上の固定バナー・トップへ戻るボタンの位置を合わせる。
    (function () {
      function syncTabH() {
        var bar = document.getElementById('tabBar');
        if (!bar) return;
        var safe = parseFloat(getComputedStyle(bar).paddingBottom) - 4 || 0;
        var h = Math.ceil(bar.getBoundingClientRect().height - Math.max(safe, 0));
        document.documentElement.style.setProperty('--tab-h', Math.max(56, h) + 'px');
      }
      syncTabH();
      window.addEventListener('resize', syncTabH);
      // 単一URLのページでは、表示している言語に合わせて、タブのリンク先と文字を書き換える
      // （サーバー側では言語が決まらないため。langChanged は base.js が最初の表示時と言語切り替え時に送る）
      var NAMES = SECTION_NAMES_JSON, BREAK = TAB_BREAK_JSON;
      function esc(t) { return t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
      window.__applyTabsLang = function (l) {
        var p = l === 'zh' ? '' : '/' + l;
        var urls = { rescue: p + '/', medical: p + '/medical/', career: p + '/career/', kurashi: '/kurashi/', apps: '/apps/' };
        document.querySelectorAll('#tabBar a[data-tab]').forEach(function (a) {
          var k = a.getAttribute('data-tab');
          a.setAttribute('href', urls[k]);
          var name = (NAMES[k] && (NAMES[k][l] || NAMES[k].en)) || '';
          var brk = BREAK[k] && BREAK[k][l];
          var html = (brk && name.indexOf(brk) === 0) ? esc(brk) + '<wbr>' + esc(name.slice(brk.length)) : esc(name);
          var lbl = a.querySelector('.tab-label');
          if (lbl) lbl.innerHTML = html;
        });
        syncTabH();
      };
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(syncTabH);
    })();
  </script>

  <!-- base.js -->
  <script src="/js/base.js" is:inline></script>

  <!-- 语言切换菜单 -->
  <script is:inline>
    document.getElementById('langBtn').addEventListener('click', function(e) {
      e.stopPropagation();
      const menu = document.getElementById('langMenu');
      menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
    });
    document.addEventListener('click', function(e) {
      const wrap = document.getElementById('langSwitchWrap');
      if (wrap && !wrap.contains(e.target)) {
        document.getElementById('langMenu').style.display = 'none';
      }
    });

    // about/medical等单一路径页面：switchLang()不会跳转页面，而是原地loadLocale后派发langChanged，
    // 这里同步更新语言按钮文案和菜单里的active高亮，否则切换后header上显示的还是旧语言
    document.addEventListener('langChanged', function(e) {
      const lang = e.detail && e.detail.lang;
      if (!lang) return;
      const langLabelsClient = {
        'zh': '简体中文', 'zh-TW': '繁體中文',
        'en': 'English', 'vi': 'Tiếng Việt', 'ko': '한국어', 'ja': '日本語'
      };
      const btn = document.getElementById('langBtn');
      if (btn) btn.textContent = `🌐 ${langLabelsClient[lang] || langLabelsClient.zh}`;
      document.querySelectorAll('#langMenu .lang-menu-item').forEach(function(item, idx) {
        const keys = Object.keys(langLabelsClient);
        item.classList.toggle('active', keys[idx] === lang);
      });
      document.getElementById('langMenu').style.display = 'none';
      if (typeof window.__applyTabsLang === 'function') window.__applyTabsLang(lang);

      // 同步页脚的"关于我们"文案和版权行（footer同样是server端按URL渲染的，
      // 在about/medical这类单一路径页面上，语言切换不刷新页面，需要客户端手动同步）
      const footerLabelsClient = {
        zh: '关于我们', 'zh-TW': '關於我們',
        en: 'About Us', vi: 'Về Chúng Tôi', ko: '소개', ja: '私たちについて'
      };
      const footerYear = new Date().getFullYear();
      const footerCopyrightClient = {
        zh: `© ${footerYear} Kurawise`,
        'zh-TW': `© ${footerYear} Kurawise`,
        en: `© ${footerYear} Kurawise`,
        vi: `© ${footerYear} Kurawise`,
        ko: `© ${footerYear} Kurawise`,
        ja: `© ${footerYear} Kurawise`
      };
      const footerAdLabelsClient = {
        zh: '关于广告', 'zh-TW': '關於廣告', en: 'Advertising Policy', vi: 'Về quảng cáo', ko: '광고 안내', ja: '広告について'
      };
      const searchPhClient = { zh: '搜索...', 'zh-TW': '搜尋...', en: 'Search...', vi: 'Tìm kiếm...', ko: '검색...', ja: '検索...' };
      const searchInputEl = document.getElementById('searchInput');
      if (searchInputEl) searchInputEl.placeholder = searchPhClient[lang] || searchPhClient.zh;
      const footerPrivacyLabelsClient = {
        zh: '隐私政策', 'zh-TW': '隱私權政策', en: 'Privacy Policy', vi: 'Quyền riêng tư', ko: '개인정보 처리방침', ja: 'プライバシーポリシー'
      };
      const footerPrivacyLink = document.getElementById('footerPrivacyLink');
      if (footerPrivacyLink) footerPrivacyLink.textContent = footerPrivacyLabelsClient[lang] || footerPrivacyLabelsClient.zh;
      const footerAdLink = document.getElementById('footerAdLink');
      if (footerAdLink) footerAdLink.textContent = footerAdLabelsClient[lang] || footerAdLabelsClient.zh;
      const footerLink = document.getElementById('footerAboutLink');
      if (footerLink) footerLink.textContent = footerLabelsClient[lang] || footerLabelsClient.zh;
      const footerCopy = document.getElementById('footerCopyright');
      if (footerCopy) footerCopy.textContent = footerCopyrightClient[lang] || footerCopyrightClient.zh;
    });
  </script>

</body>
</html>