---
import { SECTION_NAMES } from '../../../data/sectionNames';
import { MEDICAL_HUB, CAREER_HUB, pick } from '../../../data/sectionHubCopy';
import Base from '../../../layouts/Base.astro';
import careerIndex from '../../../../public/data/career/index.json';
import disclaimer from '../../../../public/data/career/disclaimer.json';

export async function getStaticPaths() {
  const SUPPORTED_LANGS = ['zh-TW', 'en', 'vi', 'ko', 'ja'];
  return SUPPORTED_LANGS.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props;

const titles: Record<string, Record<string, string>> = {
  prep:      { 'zh-TW': '履歷準備', en: 'Resume Prep', vi: 'Chuẩn bị hồ sơ', ko: '이력서 준비', ja: '履歴書準備' },
  interview: { 'zh-TW': '面試應對', en: 'Interviews', vi: 'Phỏng vấn', ko: '면접 대응', ja: '面接対応' },
  decide:    { 'zh-TW': '職位判斷', en: 'Evaluating Offers', vi: 'Đánh giá công việc', ko: '직무 판단', ja: '職務判断' },
  onboard:   { 'zh-TW': '到職適應', en: 'Onboarding', vi: 'Hòa nhập công việc', ko: '입사 적응', ja: '入社適応' }
};
const groupOrder = ['prep', 'interview', 'decide', 'onboard'];

function tf(p: any, field: string, lang: string): string {
  return p[`${field}_${lang}`] || p[field] || p[`${field}_zh`] || '';
}

const groups: Record<string, any[]> = { prep: [], interview: [], decide: [], onboard: [] };
for (const p of careerIndex.pages) {
  (groups[p.group] || (groups[p.group] = [])).push(p);
}

const langPathPrefix = `/${lang}`;

// disclaimer.json 是直接 import 的 JSON 模块，TS 会按字面量内容推断出精确类型，
// 导致用运行时变量 lang 去做动态取值时报类型错误。按协作铁律第6条，
// 这种运行时变量拼接/索引访问，要在 frontmatter 里用 Record<string, string> 断言处理好，
// 不要把 as 类型断言直接写在模板表达式区域（模板区域解析泛型语法的行为和 frontmatter 不一致）。
const disclaimerHubShort = disclaimer.hub_short as Record<string, string>;
const hubShortText = disclaimerHubShort[lang] || disclaimerHubShort.zh;
---

<Base title={pick(CAREER_HUB.title, lang)} description={pick(CAREER_HUB.description, lang)} careerCss={true}>

  <div class="career-hub-page" id="careerHubPage">
    <h1>{(SECTION_NAMES.career as Record<string, string>)[lang]}</h1>
    <p class="career-hub-intro">{pick(CAREER_HUB.intro, lang)}</p>
    <p class="career-disclaimer">{hubShortText}</p>

    {groupOrder.map((groupKey) => (
      groups[groupKey] && groups[groupKey].length > 0 && (
        <section class="career-hub-group">
          <h2>{titles[groupKey]?.[lang] || titles[groupKey]?.en || groupKey}</h2>
          <div class="career-hub-nav-grid">
            {groups[groupKey].map((p: any) => (
              <a href={`${langPathPrefix}${p.url}`} class={`career-hub-nav-card career-hub-nav-card--${groupKey}`}>
                <div class="career-hub-nav-card-title">{tf(p, 'title', lang)}</div>
                <div class="career-hub-nav-card-desc">{tf(p, 'description', lang)}</div>
              </a>
            ))}
          </div>
        </section>
      )
    ))}
  </div>

  <div data-pagefind-body style="display:none">{pick(CAREER_HUB.title, lang)} {pick(CAREER_HUB.description, lang)}</div>

</Base>
