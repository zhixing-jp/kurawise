---
// 各言語のホーム /xx/（2026-10-24）：サイトのトップ（受付と案内図）。中身は HomeHub.astro。
// 日常会話のトップは /xx/rescue/ に移した。
import Base from '../../layouts/Base.astro';
import HomeHub from '../../components/HomeHub.astro';

export function getStaticPaths() {
  return ['zh', 'zh-TW', 'en', 'vi', 'ko', 'ja'].map((lang) => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props;
const TITLE: Record<string, string> = {
  ja: '暮らしを、かしこく。｜Kurawise',
  zh: '在日本，聪明地生活。｜Kurawise',
  'zh-TW': '在日本，聰明過生活。｜Kurawise',
  en: 'Live smarter in Japan. | Kurawise',
  vi: 'Sống thông minh hơn tại Nhật. | Kurawise',
  ko: '일본 생활을, 더 현명하게. | Kurawise'
};
const DESC: Record<string, string> = {
  ja: '毎日の「どうすれば？」に、確かな情報を。日常会話・病院＆医療・仕事＆ビザ・暮らし＆お金の知恵を、6つの言語で。',
  zh: '生活中的每个“怎么办？”，都有可靠的答案。日常会话、就医、工作和签证、生活和金钱智慧，支持6种语言。',
  'zh-TW': '生活中的每個「怎麼辦？」，都有可靠的答案。日常會話、就醫、工作和簽證、生活和金錢智慧，支援6種語言。',
  en: 'Reliable answers to everyday “what do I do?” questions in Japan — daily Japanese, health care, work & visas, and money tips, in 6 languages.',
  vi: 'Thông tin đáng tin cậy cho mọi câu hỏi “phải làm sao?” khi sống ở Nhật — tiếng Nhật giao tiếp, khám bệnh, việc làm & visa, tiền bạc, bằng 6 ngôn ngữ.',
  ko: '일본 생활의 「어떻게 하지?」에 믿을 수 있는 정보를. 일본어 회화·병원·일과 비자·생활과 돈의 지혜를 6개 언어로.'
};
---
<Base title={TITLE[lang] || TITLE.en} description={DESC[lang] || DESC.en} skipReadTracking={true}>
  <HomeHub lang={lang} />
</Base>
