---
// 暮らし＆お金の知恵（タブ4）の入口 /xx/kurashi/（2026-10-24：言語ごとのURLに。日本語が母版）。
// 記事がある言語は記事の一覧を出して検索に載せる。記事がない言語は「準備中」：noindex（10/26）。記事の一覧は public/data/kurashi/index.json。
import Base from '../../../layouts/Base.astro';
import { SECTION_NAMES } from '../../../data/sectionNames';
import kurashiIndex from '../../../../public/data/kurashi/index.json';

export function getStaticPaths() {
  return ['zh', 'zh-TW', 'en', 'vi', 'ko', 'ja'].map((lang) => ({ params: { lang }, props: { lang } }));
}
const { lang } = Astro.props;
const name = (SECTION_NAMES.kurashi as Record<string, string>)[lang] || SECTION_NAMES.kurashi.en;
const BODY: Record<string, string> = {
  zh: '准备中。从日常省钱，到信用卡、手机、银行、跨境汇款、租房合同怎么选，我们会用具体的数字做比较，介绍在日本生活不吃亏的金钱智慧。',
  'zh-TW': '準備中。從日常省錢，到信用卡、手機、銀行、跨境匯款、租屋合約怎麼選，我們會用具體的數字做比較，介紹在日本生活不吃虧的金錢智慧。',
  en: 'Coming soon. From everyday savings to choosing credit cards, phone plans, banks, international money transfers and rental contracts, we will compare the options with real numbers so you don\'t lose money living in Japan.',
  vi: 'Sắp ra mắt. Từ cách tiết kiệm hằng ngày đến chọn thẻ tín dụng, điện thoại, ngân hàng, chuyển tiền quốc tế và hợp đồng thuê nhà, chúng tôi sẽ so sánh bằng con số cụ thể để bạn sống ở Nhật mà không bị thiệt.',
  ko: '준비 중입니다. 일상 속 절약부터 신용카드·휴대폰·은행·해외 송금·임대 계약을 고르는 방법까지, 구체적인 숫자로 비교해 일본 생활에서 손해 보지 않는 돈의 지혜를 소개할 예정입니다.',
  ja: '準備中です。毎日の節約から、クレジットカード・携帯電話・銀行・海外送金・部屋の契約の選び方まで、暮らしのお金で損をしないための知恵を、具体的な数字で比べて紹介していきます。'
};
const body = BODY[lang] || BODY.en;
const list = (kurashiIndex as any).articles.filter((a: any) => a.langs.includes(lang));
const INTRO: Record<string, string> = {
  zh: '信用卡、手机、银行、跨境汇款、租房合同……用具体的数字做比较，介绍生活中不吃亏的金钱智慧。写给所有在日本生活的人，也附上外国人需要注意的地方。',
  'zh-TW': '信用卡、手機、銀行、跨境匯款、租屋合約……用具體的數字做比較，介紹生活中不吃虧的金錢智慧。寫給所有在日本生活的人，也附上外國人需要注意的地方。',
  en: 'Credit cards, phone plans, banks, international transfers, rental contracts: we compare the options with real numbers so you don\'t lose money in daily life. Written for everyone living in Japan, with notes for foreign residents.',
  vi: 'Thẻ tín dụng, điện thoại, ngân hàng, chuyển tiền quốc tế, hợp đồng thuê nhà: so sánh bằng con số cụ thể để bạn không bị thiệt trong chi tiêu hằng ngày. Viết cho mọi người sống ở Nhật, kèm lưu ý cho người nước ngoài.',
  ko: '신용카드·휴대폰·은행·해외 송금·임대 계약 등, 생활 속 돈 문제에서 손해 보지 않도록 구체적인 숫자로 비교해 소개합니다. 일본에 사는 모든 분을 위해 쓰고, 외국인이 주의할 점도 덧붙였습니다.',
  ja: 'クレジットカード・携帯電話・銀行・海外送金・部屋の契約など、暮らしのお金で損をしないための知恵を、具体的な数字で比べて紹介します。日本で暮らすすべての人に向けて書き、外国人の場合の注意点も添えています。' };
const GROUPS: Record<string, Record<string, string>> = {
  remit: { ja: '海外送金で困ったとき', zh: '海外汇款遇到问题时', 'zh-TW': '海外匯款遇到問題時', en: 'Sending money abroad: when you get stuck', vi: 'Khi gặp khó khăn với chuyển tiền ra nước ngoài', ko: '해외 송금으로 곤란할 때' },
  card: { ja: 'クレジットカード', zh: '信用卡', 'zh-TW': '信用卡', en: 'Credit cards', vi: 'Thẻ tín dụng', ko: '신용카드' }
};
const ICON: Record<string, string> = { remit: '💸', card: '💳' };
const groupOrder: string[] = [];
for (const a of list) { const g = a.group || 'other'; if (!groupOrder.includes(g)) groupOrder.push(g); }
const HEAD: Record<string, string> = { ja: '記事の一覧', zh: '文章列表', 'zh-TW': '文章列表', en: 'Articles', vi: 'Bài viết', ko: '글 목록' };
---
<Base title={`${name} | Kurawise`} description={list.length ? (INTRO[lang] || body) : body} noindex={list.length === 0} skipReadTracking={true}>
  <main class="kurashi-page hub-page">
    <h1 class="hub-title">{name}</h1>
    {list.length === 0 ? (
      <section class="cblock" style="padding-top:16px">
        <p style="font-size:15px;line-height:1.9;color:var(--t2);margin:0;">{body}</p>
      </section>
    ) : (
      <>
        <p class="hub-intro">{INTRO[lang] || body}</p>
        {groupOrder.map((g) => (
          <section class="cblock">
            <h2 class="cblock-head"><span aria-hidden="true">{ICON[g] || '📚'}</span>{(GROUPS[g] && (GROUPS[g][lang] || GROUPS[g].ja)) || HEAD[lang] || HEAD.ja}</h2>
            <div class="ios-list">
              {list.filter((a: any) => (a.group || 'other') === g).map((a: any) => (
                <a class="ios-row ios-tone--green" href={`/${lang}${a.url}`}>
                  <span class="ios-ico" aria-hidden="true">{a.icon}</span>
                  <span class="ios-text"><span class="ios-title">{a[`title_${lang}`]}</span><span class="ios-sub">{a[`sub_${lang}`]}</span></span>
                  <span class="ios-chev" aria-hidden="true">›</span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </>
    )}
  </main>
</Base>
