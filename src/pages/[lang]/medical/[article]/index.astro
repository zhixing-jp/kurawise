---
// 病院＆医療の新しい記事の共通ページ（2026-11-05）：/{lang}/medical/{id}/
// 対象は public/data/medical/index.json で langs を持ち、public/data/medical/{id}.json に sections_{lang} がある記事だけ。
// 既存の記事（フォルダごとのページ）は、ここでは作らない。
// 訳のある言語（langs）だけページを作り、hreflang もその言語だけにする。
import Base from '../../../../layouts/Base.astro';
import CareerBlocks from '../../../../components/CareerBlocks.astro';
import { SECTION_NAMES } from '../../../../data/sectionNames';
import { readFileSync, existsSync } from 'node:fs';

export function getStaticPaths() {
  const idx = JSON.parse(readFileSync('public/data/medical/index.json', 'utf-8'));
  const out: any[] = [];
  for (const p of idx.pages) {
    if (!p.langs) continue;
    const f = `public/data/medical/${p.id}.json`;
    if (!existsSync(f)) continue;
    const d = JSON.parse(readFileSync(f, 'utf-8'));
    for (const lang of p.langs) if (d[`sections_${lang}`]) out.push({ params: { lang, article: p.id }, props: { lang, id: p.id, langs: p.langs, d } });
  }
  return out;
}
const { lang, id, langs, d } = Astro.props as any;
const title: string = d[`title_${lang}`];
const desc: string = d[`description_${lang}`];
const sections: any[] = d[`sections_${lang}`];
const medName = (SECTION_NAMES.medical as Record<string, string>)[lang];
const CHECKED: Record<string, string> = { ja: '確認日', zh: '确认日', 'zh-TW': '確認日', en: 'Checked', vi: 'Ngày kiểm tra', ko: '확인일' };
const sep = ['en', 'vi', 'ko'].includes(lang) ? ': ' : '：';
const alternates = [
  ...langs.map((l: string) => ({ hreflang: l === 'zh' ? 'zh-CN' : l, href: `https://kurawise.com/${l}/medical/${id}/` })),
  { hreflang: 'x-default', href: `https://kurawise.com/${langs.includes('ja') ? 'ja' : langs[0]}/medical/${id}/` }
];
---
<Base title={`${title} | Kurawise`} description={desc} medicalCss={true} articleCss={true} alternates={alternates}
  breadcrumbs={[{ name: medName, url: `https://kurawise.com/${lang}/medical/` }, { name: title }]}>
  <nav class="med-breadcrumb" aria-label="breadcrumb">
    <a href={`/${lang}/medical/`}>{medName}</a>
    <span aria-hidden="true">›</span>
    <span aria-current="page">{d[`crumb_${lang}`] || title}</span>
  </nav>
  <div class="career-article-page">
    <h1 class="career-article-title">{title}</h1>
    <p class="career-article-checked">{CHECKED[lang] || CHECKED.en}{sep}{d.checked}</p>
    <CareerBlocks sections={sections} lang={lang} />
  </div>
  <div data-pagefind-body style="display:none">{title} {desc}</div>
</Base>
