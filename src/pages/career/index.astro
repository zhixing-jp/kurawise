---
import { SECTION_NAMES } from '../../data/sectionNames';
import { MEDICAL_HUB, CAREER_HUB, pick } from '../../data/sectionHubCopy';
import Base from '../../layouts/Base.astro';
import careerIndex from '../../../public/data/career/index.json';
import disclaimer from '../../../public/data/career/disclaimer.json';

const titles: Record<string, string> = {
  prep: '简历准备', interview: '面试应对', decide: '职位判断', onboard: '入职适应'
};
const groupOrder = ['prep', 'interview', 'decide', 'onboard'];

const groups: Record<string, any[]> = { prep: [], interview: [], decide: [], onboard: [] };
for (const p of careerIndex.pages) {
  (groups[p.group] || (groups[p.group] = [])).push(p);
}
import CareerHubList from '../../components/CareerHubList.astro';
---

<Base title={CAREER_HUB.title.zh} description={CAREER_HUB.description.zh} careerCss={true}>

  <div class="career-hub-page" id="careerHubPage">
    <h1>{SECTION_NAMES.career.zh}</h1>
    <p class="career-hub-intro">{CAREER_HUB.intro.zh}</p>
    <p class="career-disclaimer">{disclaimer.hub_short.zh}</p>
    <CareerHubList lang={'zh'} />
  </div>

  <div data-pagefind-body style="display:none">{SECTION_NAMES.career.zh} {CAREER_HUB.title.zh} {CAREER_HUB.description.zh}</div>

</Base>
