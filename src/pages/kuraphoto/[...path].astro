---
// KuraPhoto（Mac・iPhone・iPad アプリ）の公開ページ（2026-11-12 に本文を JSON にそろえた）。
//   /kuraphoto/            サポート       public/data/apps/kuraphoto/support.json
//   /kuraphoto/mac/        Mac 版の使い方  public/data/apps/kuraphoto/mac/guide.json
//   /kuraphoto/iphone/     iPhone・iPad 版の使い方  public/data/apps/kuraphoto/iphone/guide.json
//   /kuraphoto/privacy/    プライバシー    public/data/apps/kuraphoto/privacy.json
//   日本語以外は /kuraphoto/<言語>/… 。設定（言語・パンくず・iosReleased）は public/data/apps/kuraphoto/index.json。
// 本文は暮らしの記事と同じ形（sections_<言語> ＝ 見出し＋型つきのブロック）で、CareerBlocks で表示する。
// URL は App Store Connect に登録したサポート URL・プライバシーポリシー URL と同じなので変えない。
// 以前の Mac 版の使い方（/kuraphoto/help/）は public/_redirects で mac/ へ転送する。
// 不进站内搜索（不加 data-pagefind-body），不计入内容阅读埋点。
import Base from '../../layouts/Base.astro';
import CareerBlocks from '../../components/CareerBlocks.astro';
import conf from '../../../public/data/apps/kuraphoto/index.json';
import { readFileSync } from 'node:fs';

const DIR = 'public/data/apps/kuraphoto/';

export function getStaticPaths() {
  return conf.pages.flatMap((p) => conf.langs.map((l) => {
    const parts = (l.folder === 'ja' ? '' : l.folder + '/') + p.path;
    return { params: { path: parts ? parts.replace(/\/$/, '') : undefined }, props: { folder: l.folder, page: p.key } };
  }));
}

const { folder, page } = Astro.props as { folder: string; page: string };
const BASE_URL = 'https://kurawise.com/kuraphoto/';
const pageInfo = conf.pages.find((p) => p.key === page)!;
const pagePath = (f: string, key: string) => (f === 'ja' ? '' : f + '/') + conf.pages.find((p) => p.key === key)!.path;

// iPhone 版を公開するまでは iPhone のことを出さない（公開後は Mac だけの文を出さない）
const keep = conf.iosReleased ? 'ios' : 'mac';
const dropTag = conf.iosReleased ? 'mac-only' : 'ios';
const keepTag = conf.iosReleased ? 'ios' : 'mac-only';
function platform(v: any): any {
  if (typeof v === 'string') {
    return v.replace(new RegExp(`<!--${dropTag}-->[\\s\\S]*?<!--/${dropTag}-->`, 'g'), '')
      .replaceAll(`<!--${keepTag}-->`, '').replaceAll(`<!--/${keepTag}-->`, '');
  }
  if (Array.isArray(v)) return v.map(platform).filter((x) => x !== null && x !== '');
  if (v && typeof v === 'object') {
    if (v.only && v.only !== keep) return null;
    return Object.fromEntries(Object.entries(v).map(([k, x]) => [k, platform(x)]));
  }
  return v;
}

const d = JSON.parse(readFileSync(DIR + pageInfo.file, 'utf-8'));
const title: string = d[`title_${folder}`];
const headTitle: string = d[`head_title_${folder}`];
const desc: string = d[`description_${folder}`];
const sections: any[] = platform(d[`sections_${folder}`]);

const langInfo = conf.langs.find((l) => l.folder === folder)!;
// hreflang：x-default は英語
const alternates = [
  ...conf.langs.map((l) => ({ hreflang: l.htmlLang, href: BASE_URL + pagePath(l.folder, page) })),
  { hreflang: 'x-default', href: BASE_URL + pagePath('en', page) }
];
// 页头的语言菜单：换成 KuraPhoto 的7种语言，直接跳到同一页面的对应语言版
const langOptions = conf.langs.map((l) => ({ label: l.label, href: '/kuraphoto/' + pagePath(l.folder, page), active: l.folder === folder }));

const crumbs = (conf.crumbs as Record<string, Record<string, string>>)[folder];
const homeHref = '/kuraphoto/' + pagePath(folder, 'support');
---

<Base
  title={headTitle}
  description={desc}
  ogImage={conf.ogImage}
  uiLang={langInfo.siteLang}
  htmlLang={langInfo.htmlLang}
  alternates={alternates}
  langOptions={langOptions}
  articleCss={true}
  appsCss={true}
  skipReadTracking={true}
  breadcrumbs={page === 'support'
    ? [{ name: crumbs.apps, url: 'https://kurawise.com/apps/' }, { name: 'KuraPhoto' }]
    : [{ name: crumbs.apps, url: 'https://kurawise.com/apps/' }, { name: 'KuraPhoto', url: 'https://kurawise.com' + homeHref }, { name: crumbs[page] }]}
>
  <nav class="kp-breadcrumb" aria-label="breadcrumb">
    <a href="/apps/">{crumbs.apps}</a>
    <span aria-hidden="true">›</span>
    {page === 'support'
      ? <span aria-current="page">KuraPhoto</span>
      : <>
          <a href={homeHref}>KuraPhoto</a>
          <span aria-hidden="true">›</span>
          <span aria-current="page">{crumbs[page]}</span>
        </>}
  </nav>
  <main class="career-article-page">
    <div class="app-head">
      <img src={conf.icon} alt="" width="56" height="56" />
      <h1 class="career-article-title">{title}</h1>
    </div>
    <CareerBlocks sections={sections} lang={langInfo.siteLang} />
  </main>
</Base>
