---
// 目标路径：src/pages/kurashi/index.astro → 映射为 /kurashi/
// 暮らし＆お金の知恵（ST）版块入口页。版块内容的URL规则为 /kurashi/{lang}/（日语为母版）。
// 现阶段还没有文章，先作为"准备中"的入口页：noindex，不进站内搜索（不加 data-pagefind-body），
// 不计入内容阅读埋点。单一路径页面，文案按当前语言在客户端显示（与 /about/ 同一模式）。
import Base from '../../layouts/Base.astro';
import { SECTION_NAMES } from '../../data/sectionNames';
const kurashiNames = SECTION_NAMES.kurashi;
---

<Base title={`${SECTION_NAMES.kurashi.ja} | Kurawise`} description="毎日の節約から、クレジットカード・携帯電話・銀行・海外送金・部屋の契約の選び方まで、暮らしのお金で損をしない知恵を数字で比べて紹介します。" noindex={true} skipReadTracking={true}>
  <main class="kurashi-page" style="max-width:640px;margin:0 auto;padding:32px 20px 80px;">
    <h1 id="kurashiTitle" style="font-size:22px;font-weight:700;margin-bottom:16px;">{SECTION_NAMES.kurashi.ja}</h1>
    <p id="kurashiBody" style="font-size:15px;line-height:1.9;color:var(--text,#333);">準備中です。毎日の節約から、クレジットカード・携帯電話・銀行・海外送金・部屋の契約の選び方まで、暮らしのお金で損をしないための知恵を、具体的な数字で比べて紹介していきます。</p>
  </main>

  <script is:inline define:vars={{ kurashiNames }}>
    function renderKurashiPage() {
      const titleMap = kurashiNames;
      const bodyMap = {
        zh: '准备中。从日常省钱，到信用卡、手机、银行、跨境汇款、租房合同怎么选，我们会用具体的数字做比较，介绍在日本生活不吃亏的金钱智慧。',
        'zh-TW': '準備中。從日常省錢，到信用卡、手機、銀行、跨境匯款、租屋合約怎麼選，我們會用具體的數字做比較，介紹在日本生活不吃虧的金錢智慧。',
        en: 'Coming soon. From everyday savings to choosing credit cards, phone plans, banks, international money transfers and rental contracts, we will compare the options with real numbers so you don\'t lose money living in Japan.',
        vi: 'Sắp ra mắt. Từ cách tiết kiệm hằng ngày đến chọn thẻ tín dụng, điện thoại, ngân hàng, chuyển tiền quốc tế và hợp đồng thuê nhà, chúng tôi sẽ so sánh bằng con số cụ thể để bạn sống ở Nhật mà không bị thiệt.',
        ko: '준비 중입니다. 일상 속 절약부터 신용카드·휴대폰·은행·해외 송금·임대 계약을 고르는 방법까지, 구체적인 숫자로 비교해 일본 생활에서 손해 보지 않는 돈의 지혜를 소개할 예정입니다.',
        ja: '準備中です。毎日の節約から、クレジットカード・携帯電話・銀行・海外送金・部屋の契約の選び方まで、暮らしのお金で損をしないための知恵を、具体的な数字で比べて紹介していきます。'
      };
      const lang = (typeof currentLang !== 'undefined' && currentLang) || 'ja';
      const t = document.getElementById('kurashiTitle');
      const b = document.getElementById('kurashiBody');
      if (t) t.textContent = titleMap[lang] || titleMap.ja;
      if (b) b.textContent = bodyMap[lang] || bodyMap.ja;
    }
    window.addEventListener('DOMContentLoaded', () => { setTimeout(renderKurashiPage, 0); });
    document.addEventListener('langChanged', renderKurashiPage);
  </script>
</Base>
