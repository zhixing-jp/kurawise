---
import { SECTION_NAMES } from '../../data/sectionNames';
import { MEDICAL_HUB, CAREER_HUB, pick } from '../../data/sectionHubCopy';
import Base from '../../layouts/Base.astro';
import medicalIndex from '../../../public/data/medical/index.json';
import disclaimer from '../../../public/data/medical/disclaimer.json';

const lang = 'zh';

const titles: Record<string, string> = {
  action: '现场执行', tool: '症状指认词库', reference: '医疗制度与常见问题'
};

const groups: Record<string, any[]> = { action: [], tool: [], reference: [] };
for (const p of medicalIndex.pages) {
  (groups[p.group] || (groups[p.group] = [])).push(p);
}
import MedicalHubList from '../../components/MedicalHubList.astro';
---

<Base title={MEDICAL_HUB.title.zh} description={MEDICAL_HUB.description.zh} medicalCss={true}>

  <div class="med-hub-page" id="medHubPage">
    <h1>{SECTION_NAMES.medical.zh}</h1>
    <p class="med-hub-intro">{MEDICAL_HUB.intro.zh}</p>
    <p class="med-disclaimer">{disclaimer.hub_short.zh}</p>

    <MedicalHubList lang={'zh'} />
  </div>

  <div data-pagefind-body style="display:none">{SECTION_NAMES.medical.zh} {MEDICAL_HUB.title.zh} {MEDICAL_HUB.description.zh}</div>

</Base>